# quickshell
# The wallpaper folders ship with two starter images (Chainsaw Man.jpg is the
# default, see shroomery/settings/wallpaper-default); anything else put in them,
# animated wallpapers included, stays local.
quickshell/WallpaperApp/wallpapers/*
!quickshell/WallpaperApp/wallpapers/Chainsaw Man.jpg
!quickshell/WallpaperApp/wallpapers/Chainsaw Man 4.png
!quickshell/WallpaperApp/wallpapers/animated/
quickshell/WallpaperApp/wallpapers/animated/*
!quickshell/WallpaperApp/wallpapers/animated/.gitkeep
quickshell/.superpowers/
quickshell/docs/superpowers/

# python bytecode (holds absolute paths of the machine that compiled it)
__pycache__/
*.pyc

# hypr: per-machine extras loaded by hyprland.lua when present (the installer
# writes NVIDIA environment variables here)
hypr/custom.lua


# runtime flag (gamemode on/off on this machine), not a default to share
shroomery/settings/gamemode-enabled
